---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PricingTiles from "../components/PricingTiles.astro";
---

<Layout>
  <Fragment slot="head">
    <meta
      name="description"
      content="Clear, simple pricing for custom websites, Shopify stores, WordPress builds, and ongoing support. Transparent starting points for every type of project."
    />
  </Fragment>
  <Hero
    title="Pricing"
    subtitle="Clear, simple starting points for every type of build"
  />
  <PricingTiles />

  <!-- Find out more section  -->
  <section class="bg-bgprimary p-10">
    <div class="content-container">
      <div
        class="mx-auto max-w-6xl grid grid-cols-1 md:grid-cols-[70%_30%] items-center gap-4"
      >
        <!-- LEFT: Text -->
        <p class="leading-relaxed py-6">
          Pricing varies depending on the size and complexity of the build, but
          these starting points give a clear sense of what to expect. If you'd
          like a more accurate idea tailored to your project, please get in
          touch.
        </p>

        <!-- RIGHT: Button -->
        <div class="flex md:justify-end justify-center">
          <a
            href="/contact"
            class="inline-block px-6 py-3 rounded-md bg-[#D7B7C4] text-bgprimary font-medium
                 hover:opacity-80 transition-opacity"
          >
            Contact me
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
