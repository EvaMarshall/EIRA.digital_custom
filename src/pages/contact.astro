---
import ContactForm from "../components/ContactForm.jsx";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ContactSection from "../components/ContactSection.astro";
---

<Layout>
	<Fragment slot="head">
		<meta
			name="description"
			content="Get in touch to discuss a new website, a redesign, or ongoing support. Clear communication, flexible options, and a calm, supportive process from start to finish."
		/>
	</Fragment>

	<Hero
		title="Contact me"
		subtitle="Let’s explore what you need and how I can help"
	/>

	<ContactForm client:load />
	<ContactSection />
</Layout>
